{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/zh-tw/",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/zh-tw/about/",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/zh-tw/contact/",
      "permanent": true
    },
    {
      "source": "/projects/",
      "destination": "/zh-tw/projects/",
      "permanent": true
    },
    {
      "source": "/projects/assetflow/",
      "destination": "/zh-tw/projects/assetflow/",
      "permanent": true
    },
    {
      "source": "/projects/bookflow/",
      "destination": "/zh-tw/projects/bookflow/",
      "permanent": true
    },
    {
      "source": "/notes/",
      "destination": "/zh-tw/notes/",
      "permanent": true
    },
    {
      "source": "/notes/date-contracts/",
      "destination": "/zh-tw/notes/date-contracts/",
      "permanent": true
    },
    {
      "source": "/notes/booking-consistency/",
      "destination": "/zh-tw/notes/booking-consistency/",
      "permanent": true
    }
  ]
}
