---
import '../styles/global.css';
import { profile } from '../config';
import { canonicalUrl, pageTitle, safeJsonLd } from '../lib/metadata';
import { localeFromPath, localizedPath, t, type Locale } from '../lib/i18n';
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  type?: 'website' | 'article';
  locale?: Locale;
  alternate?: string | null;
  anchorMap?: Record<string, string>;
  immersive?: boolean;
}
const {
  title,
  locale = localeFromPath(Astro.url.pathname),
  noindex = false,
  type = 'website',
  anchorMap = {},
  immersive = false,
} = Astro.props;
const copy = t(locale);
const description = Astro.props.description ?? copy.description;
const other = locale === 'en' ? 'zh-tw' : 'en';
const alternate =
  Astro.props.alternate === undefined
    ? Astro.url.pathname.replace(`/${locale}/`, `/${other}/`)
    : Astro.props.alternate;
const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const image = canonicalUrl('/og.png', Astro.site);
const entity = {
  '@type': 'Person',
  name: profile.name,
  sameAs: [profile.github],
  description: copy.description,
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type':
    type === 'article'
      ? 'Article'
      : Astro.url.pathname.endsWith('/about/')
        ? 'ProfilePage'
        : Astro.url.pathname === localizedPath(locale)
          ? 'WebSite'
          : 'WebPage',
  ...(canonical ? { url: canonical } : {}),
  name: title,
  description,
  inLanguage: locale === 'zh-tw' ? 'zh-TW' : 'en',
  ...(type === 'article'
    ? { headline: title, author: entity, ...(image ? { image } : {}) }
    : { about: entity }),
  ...(Astro.url.pathname.endsWith('/about/') ? { mainEntity: entity } : {}),
};
const indexable = !!Astro.site && !noindex;
const navigation = ['projects', 'notes', 'about', 'contact'] as const;
---

<!doctype html>
<html lang={locale === 'zh-tw' ? 'zh-TW' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle(title, profile.name)}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={indexable ? 'index,follow' : 'noindex,follow'}
    />
    <meta name="theme-color" content="#f3efe5" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && !noindex && (
      <link
        rel="alternate"
        hreflang={locale === 'zh-tw' ? 'zh-TW' : 'en'}
        href={canonical}
      />
    )}
    {Astro.site && alternate && !noindex && (
      <link
        rel="alternate"
        hreflang={other === 'zh-tw' ? 'zh-TW' : 'en'}
        href={canonicalUrl(alternate, Astro.site)}
      />
    )}
    {Astro.site && !noindex && (
      <link
        rel="alternate"
        hreflang="x-default"
        href={canonicalUrl(
          locale === 'zh-tw'
            ? Astro.url.pathname
            : (alternate ?? localizedPath('zh-tw')),
          Astro.site,
        )}
      />
    )}
    <meta property="og:title" content={pageTitle(title, profile.name)} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_TW'} />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={safeJsonLd(structuredData)} />
  </head>
  <body class:list={{ 'immersive-site': immersive }}>
    <a class="skip-link" href="#main">
      {copy.skip}
    </a>
    <header class="site-header wrap">
      <a class="wordmark" href={localizedPath(locale)}>
        <span class="brand-mark">
          c<span>.</span>
        </span>
        <span>
          {profile.name}
          <small>SOFTWARE ENGINEER</small>
        </span>
        <span class="sr-only">{copy.home}</span>
      </a>
      <div class="header-actions">
        {alternate && (
          <a
            class="locale-switch"
            data-locale
            data-anchor-map={JSON.stringify(anchorMap)}
            href={alternate}
            lang={other === 'en' ? 'en' : 'zh-TW'}
            hreflang={other === 'en' ? 'en' : 'zh-TW'}
            aria-label={
              other === 'en' ? 'EN — Switch to English' : '繁中 — 切換繁體中文'
            }
          >
            {other === 'en' ? 'EN' : '繁中'}
          </a>
        )}
        <button
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="navigation"
          type="button"
        >
          {copy.menu}
          <span aria-hidden="true">＋</span>
        </button>
      </div>
      <nav id="navigation" aria-label={copy.navigation}>
        {navigation.map((key, index) => (
          <a
            href={localizedPath(locale, key)}
            aria-current={
              Astro.url.pathname.startsWith(localizedPath(locale, key))
                ? 'page'
                : undefined
            }
          >
            <span class="nav-number" aria-hidden="true">
              0{index + 1}
            </span>
            {copy[key]}
          </a>
        ))}
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <div>
        <a class="footer-brand" href={localizedPath(locale)}>
          Cizing24<span>.</span>
        </a>
        <p>{copy.footer}</p>
      </div>
      <div class="footer-links">
        <a href={localizedPath(locale, 'projects')}>{copy.projects}</a>
        <a href={profile.github}>GitHub</a>
        <a href={localizedPath(locale, 'contact')}>{copy.contact}</a>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getUTCFullYear()} Cizing24</span>
        <span>AN INDEPENDENT ENGINEERING JOURNAL · VOL. 02</span>
        <a href="#main">{locale === 'en' ? 'Back to top' : '回到頂部'}</a>
      </div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#navigation');
      function closeMenu() {
        menu?.setAttribute('aria-expanded', 'false');
        nav?.classList.remove('open');
      }
      menu?.addEventListener('click', () => {
        const open = menu.getAttribute('aria-expanded') !== 'true';
        menu.setAttribute('aria-expanded', String(open));
        nav?.classList.toggle('open', open);
      });
      document.addEventListener('keydown', (event) => {
        if (
          event.key === 'Escape' &&
          menu?.getAttribute('aria-expanded') === 'true'
        ) {
          closeMenu();
          menu.focus();
        }
      });
      matchMedia('(min-width: 761px)').addEventListener('change', closeMenu);
      const switcher =
        document.querySelector<HTMLAnchorElement>('[data-locale]');
      function updateLanguageLink() {
        if (!switcher) return;
        const target = new URL(switcher.href);
        target.search = location.search;
        const mapping = JSON.parse(
          switcher.dataset.anchorMap ?? '{}',
        ) as Record<string, string>;
        let hash = '';
        try {
          hash = decodeURIComponent(location.hash.slice(1));
        } catch {
          /* Invalid URL fragment has no translated target. */
        }
        target.hash = hash ? (mapping[hash] ?? '') : '';
        switcher.href = target.href;
      }
      updateLanguageLink();
      window.addEventListener('hashchange', updateLanguageLink);
    </script>
  </body>
</html>
