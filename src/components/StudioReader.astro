---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { localeFromPath, entrySlug, localizedPath } from '../lib/i18n';
import { sortProjects, publishedNotes } from '../lib/content';
import { profile } from '../config';
import ProjectShowcase from './ProjectShowcase.astro';
import EngineeringLab from './EngineeringLab.astro';
import TableOfContents from './TableOfContents.astro';
import SkillsIndex from './SkillsIndex.astro';
import WebsiteCases from './WebsiteCases.astro';
import { isProjectIsland, projectView } from '../lib/world-config';
import type { IslandProjectId as ProjectId } from '../lib/project-introductions';
const locale = localeFromPath(Astro.url.pathname);
const en = locale === 'en';
const allProjects = sortProjects(
  await getCollection('projects', (p) => p.data.locale === locale),
);
const projects = await Promise.all(
  allProjects
    .filter((entry) => isProjectIsland(entrySlug(entry.id)))
    .map(async (entry) => ({ entry, ...(await render(entry)) })),
);
const notes = await Promise.all(
  publishedNotes(
    await getCollection('notes', (n) => n.data.locale === locale),
  ).map(async (entry) => ({ entry, ...(await render(entry)) })),
);
---

<dialog class="studio-reader" data-reader aria-labelledby="reader-title">
  <div class="reader-bar">
    <p class="mono" id="reader-title" data-reader-title>
      {en ? 'The reading room' : '工程閱覽室'}
    </p>
    <div>
      <a
        data-reader-locale
        href={`/${en ? 'zh-tw' : 'en'}/`}
        lang={en ? 'zh-TW' : 'en'}
      >
        {en ? '繁中' : 'EN'}
      </a>
      <button type="button" data-reader-close autofocus>
        {en ? 'Close' : '關閉'}
      </button>
    </div>
  </div>
  <div
    class="reader-scroll"
    data-reader-scroll
    tabindex="0"
    role="region"
    aria-labelledby="reader-title"
  >
    <section
      data-view-panel="help"
      data-title={en ? 'How to explore' : '探索操作說明'}
      hidden
    >
      <h2>{en ? 'Controls' : '操作說明'}</h2>
      <div class="prose">
        <p>
          {en
            ? 'Portfolio, Engineering Lab, Contact and CIZING open directly. BookFlow, AssetFlow and Zailongchang have their own places to explore.'
            : '作品集、工程實驗室、聯絡和 CIZING 可直接閱讀。BookFlow、AssetFlow 和在隆昌各有可探索的場景。'}
        </p>
        <p>
          {en
            ? 'Drag to rotate. Use two fingers to rotate on touch screens. The bottom controls return to all islands, zoom, pause movement and find CIZING.'
            : '拖曳旋轉視角，觸控螢幕也可使用雙指旋轉。底部按鈕可返回全景、縮放、暫停動態，以及找到 CIZING 小人。'}
        </p>
        <p>
          {en
            ? 'The four icons at the top switch between dawn, noon, sunset and night. Your selected island and time are kept in the link.'
            : '上方四個圖示可切換清晨、中午、夕陽與晚上，連結會保留目前的島嶼與時段。'}
        </p>
        <p>
          {en
            ? 'Keyboard controls and reduced-motion preferences are supported. If 3D is unavailable, the map and all reading panels remain usable.'
            : '支援鍵盤與減少動態效果設定。無法使用 3D 時，仍可操作地圖與所有閱讀框。'}
        </p>
      </div>
    </section>
    <section
      data-view-panel="projects"
      data-title={en ? 'All projects' : '作品總覽'}
      hidden
    >
      <h2>{en ? 'Portfolio' : '作品集'}</h2>

      <div class="reader-project-grid">
        {allProjects.map((entry) => (
          <article>
            {isProjectIsland(entrySlug(entry.id)) && (
              <Image
                src={entry.data.cover}
                alt={entry.data.coverAlt}
                width={680}
                loading="lazy"
              />
            )}
            <p class="eyebrow">{entry.data.category}</p>
            <h3>{entry.data.title}</h3>
            <p>{entry.data.description}</p>
            <div class="reader-actions">
              {isProjectIsland(entrySlug(entry.id)) && (
                <button type="button" data-enter-world={entrySlug(entry.id)}>
                  {en ? 'Enter the world' : '進入專案場景'}
                </button>
              )}
              <a
                class="text-link"
                data-open={
                  isProjectIsland(entrySlug(entry.id))
                    ? projectView(entrySlug(entry.id) as ProjectId, '-case')
                    : undefined
                }
                href={localizedPath(locale, `projects/${entrySlug(entry.id)}`)}
              >
                {en ? 'Read case study' : '閱讀完整案例'}
              </a>
            </div>
          </article>
        ))}
      </div>
      <WebsiteCases locale={locale} />
    </section>
    {projects.map(({ entry, Content }) => (
      <article
        data-view-panel={projectView(entrySlug(entry.id) as ProjectId, '-case')}
        data-title={entry.data.title}
        hidden
      >
        <p class="eyebrow">PROJECT / {entry.data.category}</p>
        <h2>{entry.data.title}</h2>
        <p class="reader-lead">{entry.data.description}</p>
        <a
          class="text-link"
          href={
            localizedPath(locale) +
            `?island=${entrySlug(entry.id)}&view=project-${entrySlug(entry.id)}`
          }
          data-open={projectView(entrySlug(entry.id) as ProjectId)}
        >
          {en ? 'Open the interactive showcase' : '開啟互動展示'}
        </a>
        <div class="prose reader-prose">
          <Content />
        </div>
        <button type="button" class="text-link" data-reader-share>
          {en ? 'Copy link to this case study' : '複製此案例連結'}
        </button>
      </article>
    ))}
    {projects.map(({ entry }) => (
      <ProjectShowcase {entry} {locale} />
    ))}
    <section
      data-view-panel="journal"
      data-title={en ? 'Engineering Lab' : 'Engineering Lab 工程實驗室'}
      hidden
    >
      <p class="eyebrow">CIZING / ENGINEERING LAB</p>
      <h2>{en ? 'Engineering Lab' : '工程實驗室'}</h2>
      <EngineeringLab locale={locale} notes={notes.map(({ entry }) => entry)} />
    </section>
    {notes.map(({ entry, Content, headings }) => (
      <article
        data-view-panel={`note-${entrySlug(entry.id)}`}
        data-title={entry.data.title}
        hidden
      >
        <a
          class="text-link"
          data-open="journal"
          href={localizedPath(locale, 'notes')}
        >
          {en ? 'Back to Engineering Lab' : '回工程實驗室'}
        </a>
        <p class="eyebrow">FIELD NOTE / {entry.data.category}</p>
        <h2>{entry.data.title}</h2>
        <p class="reader-lead">{entry.data.description}</p>
        <details class="reader-contents">
          <summary>{en ? 'In this note' : '本篇目錄'}</summary>
          <TableOfContents headings={headings} />
        </details>
        <div class="prose reader-prose">
          <Content />
        </div>
      </article>
    ))}
    <section
      data-view-panel="zailongchang"
      data-title={en ? 'Zailongchang' : '在隆昌'}
      hidden
    >
      <p class="eyebrow">ZAILONGCHANG / {en ? 'LIVE WEBSITE' : '已上線網站'}</p>
      <h2>
        {en ? 'A place between mountains and sea.' : '在山與海之間，認識隆昌。'}
      </h2>
      <p class="reader-lead">
        {en
          ? 'A continuing local website for place introductions, cultural stories, services and collaborative exhibitions. This independent island has a harbor and no land bridge.'
          : '以地方品牌為長期主體，整理隆昌介紹、文化故事、地方服務與合作展覽。這座獨立小島擁有港口，與工程群島之間沒有陸橋。'}
      </p>
      <div class="reader-actions">
        <a href="https://zailongchang.tw/">
          {en ? 'Visit the live website' : '前往在隆昌網站'}
        </a>
        <button type="button" data-open="note-zailongchang-development">
          {en ? 'Development notes' : '網站開發筆記'}
        </button>
        <button type="button" data-open="note-youth-village-action">
          {en ? 'Personal application record' : '個人計畫申請紀錄'}
        </button>
      </div>
      <p>
        {en
          ? 'The website is live. The government-plan application is recorded separately and does not imply an award or completed cultural-program outcomes.'
          : '網站已上線；政府計畫另列為個人申請紀錄，不表示已獲補助，也不把提案內容當成已完成的文化成果。'}
      </p>
    </section>
    <section
      data-view-panel="about"
      data-title={en ? 'About CIZING' : '關於 CIZING'}
      hidden
    >
      <h2>CIZING</h2>
      <p class="reader-lead">
        {en
          ? 'Frontend and web engineering. My projects include BookFlow, a booking system, and AssetFlow, an IT asset management system.'
          : '前端／網頁工程師求職作品。包含預約系統 BookFlow，以及 IT 資產管理系統 AssetFlow。'}
      </p>
      <div class="prose reader-prose">
        <h3>
          {en
            ? 'From a real workflow to a working system'
            : '從實際流程，走到可運作的系統'}
        </h3>
        <p>
          {en
            ? 'I am CIZING, a full-stack developer interested in the connection between user workflows, interfaces and data consistency. BookFlow explores booking and tenant boundaries; AssetFlow follows equipment through its lifecycle. Zailongchang brings that work into a local cultural website, while client work adds practical constraints around everyday operations and maintenance.'
            : '我是 CIZING，關注使用者流程、介面與資料一致性之間的關係。BookFlow 練習預約與租戶邊界，AssetFlow 跟著設備生命週期整理業務規則；在隆昌讓這些思考走進地方文化網站，接案開發則帶來日常營運與維護上的實際限制。'}
        </p>
        <h3>{en ? 'How I approach development' : '我如何處理開發問題'}</h3>
        <p>
          {en
            ? 'I begin by identifying who uses a process, what can fail and which rules must remain true. Then I trace the interface through the API and data layer, and keep verification evidence alongside the implementation. A completed feature, a passing local test and a live deployment are recorded as separate facts.'
            : '我會先釐清誰在使用、流程可能在哪裡失敗，以及哪些規則不能被破壞，再把介面、API 與資料層串起來。實作完成、本機測試通過與正式部署是不同的事，我希望每一項都有可以回頭檢查的依據。'}
        </p>
        <h3>{en ? 'Work, learning and collaboration' : '作品、學習與協作'}</h3>
        <p>
          {en
            ? 'I use AI to help trace code and check decisions. I keep the sources and verification results with each project. I welcome conversations about full-stack development and maintainable systems.'
            : '我會用 AI 協助追查程式與檢查決策，並把來源與驗證結果留在各個專案裡。歡迎交流全端開發與系統維護。'}
        </p>
      </div>
      <div class="reader-actions">
        <button type="button" data-open="projects">
          {en ? 'Portfolio' : '查看作品'}
        </button>
        <button type="button" data-open="contact">
          {en ? 'Contact' : '聯絡方式'}
        </button>
      </div>
    </section>
    <section
      data-view-panel="skills"
      data-title={en ? 'Skills & evidence' : '技術與證據'}
      hidden
    >
      <a
        class="text-link"
        data-open="journal"
        href={localizedPath(locale, 'notes')}
      >
        {en ? 'Back to Engineering Lab' : '回工程實驗室'}
      </a>
      <SkillsIndex locale={locale} />
    </section>
    <section
      data-view-panel="contact"
      data-title={en ? 'Start a conversation' : '聯絡與交流'}
      hidden
    >
      <h2>{en ? 'Contact' : '聯絡方式'}</h2>
      <p class="reader-lead">
        {en
          ? 'For project discussions, technical conversations and software engineering opportunities.'
          : '歡迎交流作品、技術，以及軟體工程的工作機會。'}
      </p>
      <div class="reader-contact-links">
        {profile.email && (
          <a href={`mailto:${profile.email}`}>
            <span>Email</span>
            <strong>{profile.email}</strong>
          </a>
        )}
        <a href={profile.github}>
          <span>GitHub</span>
          <strong>CIZING</strong>
        </a>
        {profile.linkedin && (
          <a href={profile.linkedin}>
            <span>LinkedIn</span>
            <strong>{en ? 'Professional profile' : '專業經歷'}</strong>
          </a>
        )}
      </div>
    </section>
  </div>
</dialog>
