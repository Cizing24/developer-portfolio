---
import type { MarkdownHeading } from 'astro';
import { localeFromPath, t } from '../lib/i18n';
interface Props {
  headings: MarkdownHeading[];
}
const copy = t(localeFromPath(Astro.url.pathname));
const headings = Astro.props.headings.filter((heading) => heading.depth === 2);
---

<aside class="toc" aria-label={copy.toc}>
  <h2>{copy.toc}</h2>
  <ol>
    {headings.map((heading) => (
      <li>
        <a href={`#${heading.slug}`}>{heading.text}</a>
      </li>
    ))}
  </ol>
</aside>
