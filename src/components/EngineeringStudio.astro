---
import { localeFromPath, localizedPath } from '../lib/i18n';
import {
  islands,
  dayPhases,
  directIslandView,
  phaseName,
  islandItems,
} from '../lib/world-config';
import StudioReader from './StudioReader.astro';
import WorldIcon from './WorldIcon.astro';
import '../styles/studio.css';
const locale = localeFromPath(Astro.url.pathname);
const en = locale === 'en';
---

<div
  id="studio"
  class="studio"
  data-studio
  data-language={locale}
  data-mode="overview"
  data-renderer="loading"
  data-phase="noon"
  data-menu="closed"
  data-traveling="false"
>
  <header class="world-header">
    <h1>
      <span class="world-brand">CIZING</span>
    </h1>
    <div
      class="world-time"
      role="group"
      aria-label={en ? 'Time of day' : '場景時段'}
    >
      {dayPhases.map((phase) => (
        <button
          type="button"
          data-phase-choice={phase}
          aria-pressed={phase === 'noon' ? 'true' : 'false'}
          aria-label={phaseName(phase, locale)}
          title={phaseName(phase, locale)}
        >
          <WorldIcon name={phase} />
        </button>
      ))}
    </div>
    <a
      class="world-language"
      data-world-locale
      href={`/${en ? 'zh-tw' : 'en'}/`}
      lang={en ? 'zh-TW' : 'en'}
      aria-label={en ? '繁中 — 切換繁體中文' : 'EN — Switch to English'}
    >
      {en ? '繁中' : 'EN'}
    </a>
  </header>
  <div class="studio-world">
    <div class="studio-viewport" data-viewport>
      <div class="studio-loading">
        <svg
          viewBox="0 0 180 80"
          width="180"
          height="80"
          aria-hidden="true"
          fill="none"
        >
          <path
            d="M22 37 37 21l20 4 9 12-14 12-25-2ZM69 52l10-16 20-6 16 8 1 14-15 13-25-3ZM123 27l11-12 22 2 9 10-8 11-23 2ZM135 59l12-8 15 3 6 9-14 6-15-2Z"
            fill="#e1e2ca"
            stroke="currentColor"
          />
          <path
            d="m58 43 16 4m38-7 16-7m-113 25 13-2m23 7 14-2m93-20 14-2m-52 32 12-2"
            stroke="currentColor"
            stroke-linecap="round"
          />
        </svg>
        <p class="mono" aria-hidden="true">
          CIZING / ARCHIPELAGO
        </p>
        <p role="status">{en ? 'Preparing the islands…' : '正在準備群島…'}</p>
        <a href={localizedPath(locale, 'projects')}>
          {en ? 'Read the projects' : '閱讀作品'}
        </a>
      </div>
      <div class="studio-fallback" data-fallback hidden>
        <p data-fallback-message role="status"></p>
        <div>
          <button type="button" data-scene-retry>
            {en ? 'Retry 3D' : '重試 3D'}
          </button>
          <a href={localizedPath(locale, 'projects')}>
            {en ? 'Read the projects' : '閱讀作品'}
          </a>
        </div>
      </div>
      <div
        class="world-portals"
        role="group"
        aria-label={en ? 'Islands' : '島嶼'}
      >
        {islands.map((island, index) => (
          <button
            type="button"
            class="world-portal"
            data-portal={island.id}
            aria-haspopup={directIslandView(island.id) ? 'dialog' : undefined}
          >
            <span class="island-number" aria-hidden="true">
              0{index + 1}
            </span>
            <span>{en ? island.en : island.zh}</span>
          </button>
        ))}
      </div>
      <div
        class="studio-labels"
        role="group"
        aria-label={en ? 'Island contents' : '島嶼內容'}
      >
        {[0, 1, 2].map((index) => (
          <button
            type="button"
            class="studio-node"
            data-station={index}
            aria-haspopup="dialog"
            hidden
          >
            <span class="hotspot-dot" aria-hidden="true"></span>
            <span data-node-title></span>
          </button>
        ))}
      </div>
    </div>
  </div>
  <button
    type="button"
    class="world-menu-toggle"
    data-menu-toggle
    aria-expanded="false"
    aria-controls="island-index"
    aria-label={en ? 'Island menu' : '島嶼選單'}
    title={en ? 'Island menu' : '島嶼選單'}
  >
    <WorldIcon name="menu" />
  </button>
  <aside
    class="world-index"
    id="island-index"
    data-index
    aria-label={en ? 'Island menu' : '島嶼選單'}
    aria-hidden="true"
    inert
  >
    <div class="index-heading">
      <h2>{en ? 'Islands' : '島嶼清單'}</h2>
      <button
        type="button"
        data-menu-close
        aria-label={en ? 'Close menu' : '關閉選單'}
      >
        <WorldIcon name="close" />
      </button>
    </div>
    <label class="sr-only" for="island-search">
      {en ? 'Search islands or contents' : '搜尋島嶼或內容'}
    </label>
    <input
      id="island-search"
      data-island-search
      type="search"
      placeholder={en ? 'Search islands or contents…' : '搜尋島嶼或內容…'}
      autocomplete="off"
    />
    <nav aria-label={en ? 'World navigation' : '世界導覽'}>
      <div class="index-reading">
        <a href={localizedPath(locale, 'contact')} data-open="contact">
          {en ? 'Contact' : '聯絡'}
        </a>
      </div>
      {islands.map((island, index) => (
        <div
          class="index-row"
          data-index-row={island.id}
          data-search={`${island.zh} ${island.en} ${island.id === 'portfolio' ? '作品總覽 All projects BookFlow AssetFlow 棉麻屋 在隆昌' : island.id === 'journal' ? 'Engineering Lab 技術與證據 AI 協作' : island.id === 'about' ? '關於 About' : ''} ${islandItems(
            island.id,
            locale,
          )
            .map((item) => item.title)
            .join(' ')}`}
        >
          <button
            type="button"
            class="index-island"
            data-island-go={island.id}
            aria-expanded={directIslandView(island.id) ? undefined : 'false'}
            aria-haspopup={directIslandView(island.id) ? 'dialog' : undefined}
          >
            <span class="mono">0{index + 1}</span>
            <span>{en ? island.en : island.zh}</span>
            <span class="index-count" aria-hidden="true">
              {directIslandView(island.id)
                ? en
                  ? 'Read'
                  : '閱讀'
                : islandItems(island.id, locale).length}
            </span>
          </button>
          {!directIslandView(island.id) && (
            <div class="index-details" data-index-details={island.id} hidden>
              {islandItems(island.id, locale).map((item) => (
                <button
                  type="button"
                  class="index-content"
                  data-open={item.view}
                >
                  {item.title}
                </button>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>
    <p class="index-empty" data-index-empty hidden>
      {en ? 'No matching islands' : '找不到符合的島嶼'}
    </p>
  </aside>
  <div
    class="world-tools"
    role="group"
    aria-label={en ? 'Scene controls' : '場景控制'}
  >
    <button
      type="button"
      data-overview
      aria-label={en ? 'All islands' : '群島全景'}
      title={en ? 'All islands' : '群島全景'}
    >
      <WorldIcon name="home" />
    </button>
    <button
      type="button"
      data-zoom="in"
      aria-label={en ? 'Zoom in' : '拉近視角'}
      title={en ? 'Zoom in' : '拉近視角'}
    >
      <WorldIcon name="zoom-in" />
    </button>
    <button
      type="button"
      data-zoom="out"
      aria-label={en ? 'Zoom out' : '拉遠視角'}
      title={en ? 'Zoom out' : '拉遠視角'}
    >
      <WorldIcon name="zoom-out" />
    </button>
    <button
      type="button"
      data-motion
      aria-pressed="true"
      aria-label={en ? 'Pause motion' : '暫停動態'}
      title={en ? 'Pause motion' : '暫停動態'}
    >
      <span data-motion-pause>
        <WorldIcon name="pause" />
      </span>
      <span data-motion-play hidden>
        <WorldIcon name="play" />
      </span>
    </button>
    <button
      type="button"
      data-avatar-focus
      aria-label={en ? 'Find CIZING' : '找到 CIZING'}
      title={en ? 'Find CIZING' : '找到 CIZING'}
    >
      <WorldIcon name="user" />
    </button>
    <button
      type="button"
      data-open="help"
      aria-label={en ? 'Help' : '操作說明'}
      title={en ? 'Help' : '操作說明'}
    >
      <WorldIcon name="info" />
    </button>
  </div>
  <p class="sr-only" role="status" data-scene-status></p>
  <StudioReader />
  <noscript>
    <style is:inline>
      .studio-loading,
      .world-menu-toggle,
      .world-time,
      .world-tools {
        display: none !important;
      }
    </style>
    <div class="world-nojs">
      <h2>{en ? 'Portfolio' : '作品集'}</h2>
      <a href={localizedPath(locale, 'projects')}>{en ? 'Projects' : '作品'}</a>
      <a href={localizedPath(locale, 'notes')}>{en ? 'Notes' : '筆記'}</a>
      <a href={localizedPath(locale, 'about')}>{en ? 'About' : '關於'}</a>
      <a href={localizedPath(locale, 'contact')}>{en ? 'Contact' : '聯絡'}</a>
    </div>
  </noscript>
</div>
<script>
  import { initStudio } from '../lib/studio';
  document.querySelectorAll<HTMLElement>('[data-studio]').forEach(initStudio);
</script>
