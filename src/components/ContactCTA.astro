---
import { localeFromPath, localizedPath, t } from '../lib/i18n';
const locale = localeFromPath(Astro.url.pathname);
const copy = t(locale);
---

<section class="wrap contact-cta">
  <p class="eyebrow">NEXT CONVERSATION</p>
  <h2>{copy.ctaTitle}</h2>
  <div class="cta-bottom">
    <p>{copy.ctaCopy}</p>
    <a class="text-link" href={localizedPath(locale, 'contact')}>
      {copy.ctaLink}
    </a>
  </div>
</section>
