---
import type { Locale } from '../lib/i18n';
import BookFlowDemo from './BookFlowDemo.astro';
import AssetFlowDemo from './AssetFlowDemo.astro';
interface Props {
  project: 'bookflow' | 'assetflow';
  locale: Locale;
}
const { project, locale } = Astro.props;
---

{project === 'bookflow' ? (
  <BookFlowDemo {locale} />
) : (
  <AssetFlowDemo {locale} />
)}
