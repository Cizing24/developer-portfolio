---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { publishedNotes, formatDate, readingMinutes } from '../../lib/content';
export async function getStaticPaths() {
  return publishedNotes(await getCollection('notes')).map((note) => ({
    params: { slug: note.id },
    props: { note },
  }));
}
interface Props {
  note: CollectionEntry<'notes'>;
}
const { note } = Astro.props;
const { Content, headings } = await render(note);
const notes = publishedNotes(await getCollection('notes'));
const index = notes.findIndex((n) => n.id === note.id);
const previous = notes[index - 1];
const next = notes[index + 1];
---

<Base
  title={note.data.title}
  description={note.data.description}
  type="article"
>
  <div class="wrap">
    <section class="case-intro">
      <nav class="breadcrumbs" aria-label="麵包屑">
        <a href="/">首頁</a>
        <span>/</span>
        <a href="/notes/">技術筆記</a>
      </nav>
      <p class="eyebrow">{note.data.category} / ENGINEERING NOTES</p>
      <h1 style="font-size:clamp(2rem,4.5vw,3.7rem);max-width:1000px">
        {note.data.title}
      </h1>
      <p class="case-description">{note.data.description}</p>
      <p class="muted" style="margin-top:24px;font-size:.8rem">
        <time datetime={note.data.publishedAt}>
          {formatDate(note.data.publishedAt)}
        </time>{' '}
        · 約 {readingMinutes(note.body)} 分鐘閱讀
      </p>
      <ul class="tags">
        {note.data.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    </section>
    <div class="article-layout">
      <TableOfContents headings={headings} />
      <article class="prose">
        <Content />
        <nav class="article-footer" aria-label="閱讀導覽">
          <a href="/notes/">← 所有筆記</a>
          {previous && (
            <p>
              <a href={`/notes/${previous.id}/`}>
                上一篇：{previous.data.title}
              </a>
            </p>
          )}
          {next && (
            <p>
              <a href={`/notes/${next.id}/`}>下一篇：{next.data.title}</a>
            </p>
          )}
        </nav>
      </article>
    </div>
  </div>
</Base>
