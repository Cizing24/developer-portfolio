---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { profile } from '../config';
import { sortProjects, publishedNotes, formatDate } from '../lib/content';
const projects = sortProjects(await getCollection('projects')).filter(
  (p) => p.data.featured,
);
const notes = publishedNotes(await getCollection('notes')).slice(0, 2);
---

<Base title="從想法到可靠的軟體">
  <section class="wrap hero">
    <div class="hero-top">
      <p class="eyebrow">
        <span class="live-dot"></span> {profile.role.toUpperCase()} / PORTFOLIO
      </p>
      <span class="mono hero-edition">SELECTED WORK · 2026</span>
    </div>
    <h1>
      不只讓程式運作，
      <br />
      讓每個<span class="accent">設計有依據。</span>
    </h1>
    <div class="hero-bottom">
      <p>
        我是 {profile.name}，專注全端開發。
        <br />
        從介面、API 到資料庫，打造可理解、
        <br class="desktop-break" />
        可驗證，也能持續演進的軟體。
      </p>
      <div class="hero-links">
        <a class="button" href="/projects/">
          探索我的作品 <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href="/about/">
          認識我的工程方法 →
        </a>
      </div>
      <span class="hero-index" aria-hidden="true">
        &lt;/&gt;
      </span>
    </div>
    <div class="hero-strip mono">
      <span>FULL-STACK DEVELOPMENT</span>
      <span>TYPESCRIPT / VUE / NEXT.JS</span>
      <span>SCROLL TO EXPLORE ↓</span>
    </div>
  </section>
  <section class="wrap section" aria-labelledby="work-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / SELECTED WORK</p>
        <h2 id="work-heading">用作品，說明思考。</h2>
      </div>
      <a class="text-link" href="/projects/">
        所有作品 <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </section>
  <section class="skills-section">
    <div class="wrap skills-layout">
      <div>
        <p class="eyebrow">02 / ENGINEERING TOOLKIT</p>
        <h2>
          從使用體驗，
          <br />
          到系統的底層。
        </h2>
        <p class="muted">
          工具是選擇，解決問題才是目的。
          <br />
          以下技術皆對應實際作品。
        </p>
      </div>
      <div class="skill-list">
        {[
          [
            '01',
            'Frontend',
            'Vue 3 · Next.js · TypeScript',
            '元件化介面、型別契約與響應式體驗。',
          ],
          [
            '02',
            'Backend & Data',
            'Fastify · PostgreSQL · Prisma',
            '把授權、交易一致性與業務規則放在正確的邊界。',
          ],
          [
            '03',
            'Quality & Delivery',
            'Vitest · Playwright · GitHub Actions',
            '用自動化測試與可重現建置，讓改動有據可查。',
          ],
        ].map(([number, title, tools, description]) => (
          <div class="skill-row">
            <span class="mono muted">{number}</span>
            <div>
              <h3>{title}</h3>
              <p class="skill-tools">{tools}</p>
              <p>{description}</p>
            </div>
            <span aria-hidden="true">↗</span>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="wrap section about-preview">
    <div>
      <p class="eyebrow">03 / HOW I APPROACH ENGINEERING</p>
      <h2>
        先理解問題，
        <br />
        再寫下答案。
      </h2>
    </div>
    <div>
      <p class="large-copy">
        我在意的不只是功能完成，還有系統在邊界條件下，是否依然值得信賴。
      </p>
      <p class="muted">
        從設備不能被重複領用，到預約不能在同一時段撞期：把抽象需求轉成清楚的資料規則，再以測試驗證，是這些作品共同的工程方法。
      </p>
      <a class="text-link" href="/about/">
        更多關於我 →
      </a>
    </div>
  </section>
  <section class="wrap section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">04 / ENGINEERING NOTES</p>
        <h2>留下決策的脈絡。</h2>
      </div>
      <a class="text-link" href="/notes/">
        所有筆記 ↗
      </a>
    </div>
    <div class="notes-list">
      {notes.map((note) => (
        <a class="note-row" href={`/notes/${note.id}/`}>
          <span class="mono muted">{formatDate(note.data.publishedAt)}</span>
          <div>
            <span class="eyebrow">{note.data.category}</span>
            <h3>{note.data.title}</h3>
            <p>{note.data.description}</p>
          </div>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
  <ContactCTA />
</Base>
