---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { entrySlug, localizedPath } from '../../../lib/i18n';
export async function getStaticPaths() {
  return (await getCollection('projects')).map((project) => ({
    params: { locale: project.data.locale, slug: entrySlug(project.id) },
    props: { project },
  }));
}
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data } = project;
const locale = data.locale;
const en = locale === 'en';
const slug = entrySlug(project.id);
const { Content } = await render(project);
const ids = [
  'main',
  `${slug}-purpose`,
  `${slug}-features`,
  `${slug}-architecture`,
];
---

<Base
  title={data.title}
  description={data.description}
  type="article"
  anchorMap={Object.fromEntries(ids.map((id) => [id, id]))}
>
  <div class="wrap simple-project-page">
    <section class="page-heading">
      <p class="eyebrow">PROJECT / {data.category}</p>
      <h1>{data.title}</h1>
      <p>{data.description}</p>
      <a class="text-link" href={localizedPath(locale) + `?studio=${slug}`}>
        {en
          ? 'Explore this project in the islands'
          : '在互動群島中探索這個專案'}
      </a>
    </section>
    <figure class="case-cover">
      <Image
        src={data.cover}
        alt={data.coverAlt}
        widths={[640, 960, 1400]}
        sizes="(max-width:760px) 90vw,1200px"
        loading="eager"
      />
      <figcaption>
        {en
          ? 'Actual product screen with synthetic test data.'
          : '實際產品畫面，使用合成測試資料。'}
      </figcaption>
    </figure>
    <Content />
    <details class="simple-project-source">
      <summary>{en ? 'Project status and source' : '專案狀態與來源'}</summary>
      <p>
        {en
          ? 'Implemented as a project; no public login or live demo is provided.'
          : '已完成專案實作，未提供公開登入或線上 Demo。'}
      </p>
      {data.repository ? (
        <a href={data.repository}>GitHub</a>
      ) : (
        <p>{en ? 'Private source code.' : '原始碼為私人專案，不公開連結。'}</p>
      )}
      <p>
        {en ? 'Source review version' : '來源查核版本'}：
        <code>{data.sourceCommit}</code> · {data.reviewedAt}
      </p>
    </details>
  </div>
</Base>
<style is:global>
  .simple-project-page {
    padding-bottom: 80px;
  }
  .simple-project-page > .project-introduction {
    max-width: 850px;
    margin: 60px auto;
  }
  .simple-project-source {
    max-width: 850px;
    margin: 40px auto;
    border-top: 1px solid var(--line);
    padding-top: 24px;
  }
  .simple-project-source summary {
    min-height: 44px;
  }
</style>
