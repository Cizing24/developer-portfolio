---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import FlowSimulation from '../../../components/FlowSimulation.astro';
import { entrySlug, localizedPath, t } from '../../../lib/i18n';
export async function getStaticPaths() {
  return (await getCollection('projects')).map((project) => ({
    params: { locale: project.data.locale, slug: entrySlug(project.id) },
    props: { project },
  }));
}
interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data } = project;
const locale = data.locale;
const en = locale === 'en';
const copy = t(locale);
const slug = entrySlug(project.id);
const { Content, headings } = await render(project);
const counterpart = (await getCollection('projects')).find(
  (p) =>
    p.data.locale !== locale && p.data.translationKey === data.translationKey,
);
const other = counterpart ? await render(counterpart) : null;
const stable = ['main', 'overview', 'deep-dive', 'evidence', 'simulation'];
const anchorMap = Object.fromEntries([
  ...stable.map((id) => [id, id]),
  ...headings
    .filter((h) => h.depth === 2)
    .map((h, i) => [
      h.slug,
      other?.headings.filter((x) => x.depth === 2)[i]?.slug ?? 'deep-dive',
    ]),
]);
---

<Base
  title={data.title}
  description={data.description}
  type="article"
  alternate={
    counterpart
      ? localizedPath(
          counterpart.data.locale,
          `projects/${entrySlug(counterpart.id)}`,
        )
      : null
  }
  anchorMap={anchorMap}
>
  <div class="wrap">
    <section class="case-intro">
      <nav class="breadcrumbs" aria-label={en ? 'Breadcrumbs' : '麵包屑'}>
        <a href={localizedPath(locale)}>{copy.home}</a>
        <span>/</span>
        <a href={localizedPath(locale, 'projects')}>{copy.projects}</a>
        <span>/</span>
        <span aria-current="page">{data.title}</span>
      </nav>
      <p class="eyebrow">FIELD STUDY / {data.category}</p>
      <h1>
        {data.title}
        <span class="accent">.</span>
      </h1>
      <p class="case-description">{data.description}</p>
      <ul class="tags">
        {data.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
      <dl class="case-facts">
        <div>
          <dt>{copy.status}</dt>
          <dd>{en ? 'Implemented · isolated showcase' : data.status}</dd>
        </div>
        <div>
          <dt>{copy.deployment}</dt>
          <dd>{en ? 'Not publicly deployed' : '未公開部署'}</dd>
        </div>
        <div>
          <dt>{copy.source}</dt>
          <dd>
            {data.repository ? (
              <a class="text-link" href={data.repository}>
                GitHub
              </a>
            ) : (
              copy.private
            )}
          </dd>
        </div>
        <div>
          <dt>{copy.review}</dt>
          <dd>
            <time datetime={data.reviewedAt}>{data.reviewedAt}</time>
          </dd>
        </div>
      </dl>
    </section>
    <nav class="reading-map" aria-label={en ? 'Reading map' : '閱讀地圖'}>
      <a href="#overview">01 / {copy.quick}</a>
      <a href="#deep-dive">02 / {copy.deep}</a>
      <a href="#evidence">03 / {copy.evidence}</a>
    </nav>
    <section id="overview" class="quick-overview">
      <div>
        <p class="eyebrow">THE PROJECT AT A GLANCE</p>
        <h2>{copy.quick}</h2>
      </div>
      <div>
        <p class="large-copy">{data.description}</p>
        <ul>
          {data.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
        <p class="muted">
          {en
            ? 'These cases describe implemented systems, recorded verification and explicit limits. No live backend is connected to this website.'
            : '案例區分已實作系統、既有測試紀錄與已知限制；本網站不連線真實業務後端。'}
        </p>
      </div>
    </section>
    <figure class="case-cover">
      <Image
        src={data.cover}
        alt={data.coverAlt}
        widths={[640, 960, 1400]}
        sizes="(max-width:760px) 90vw, 1200px"
        loading="eager"
      />
      <figcaption>{copy.screenshot}</figcaption>
    </figure>
    <section id="simulation" class="case-simulation">
      <p class="eyebrow">EXPLAIN THE SYSTEM / INTERACTIVE LAB</p>
      <FlowSimulation system={slug === 'bookflow' ? 'bookflow' : 'assetflow'} />
    </section>
    <div id="deep-dive" class="deep-heading">
      <p class="eyebrow">THE COMPLETE ENGINEERING STORY</p>
      <h2>{copy.deep}</h2>
    </div>
    <div class="article-layout">
      <TableOfContents headings={headings} />
      <article class="prose">
        <Content />
        <section id="evidence" class="evidence-panel">
          <h2>{copy.evidence}</h2>
          <p>
            {en ? 'Source review version' : '內容查核版本'}:{' '}
            <code>{data.sourceCommit}</code> · {data.reviewedAt}
          </p>
          <p>
            {en
              ? 'Source-project test counts above are historical records. This portfolio does not rerun those suites or infer capacity from them.'
              : '上述來源專案測試數為歷史紀錄；本網站沒有重新執行其測試，也不據此推論容量。'}
          </p>
          <details>
            <summary>
              {en
                ? 'Review sources and disclosure boundaries'
                : '查閱來源與公開邊界'}
            </summary>
            <p>
              {en
                ? 'Reviewed: architecture, technical decisions, database constraints, tests and lifecycle services. AssetFlow publishes rewritten summaries only; BookFlow provides its confirmed public source. Screenshots use synthetic data.'
                : '查核內容涵蓋架構、技術決策、資料庫約束、測試與生命週期服務。AssetFlow 僅公開重寫摘要；BookFlow 保留已確認公開來源。產品截圖使用合成資料。'}
            </p>
            <a href="https://github.com/Cizing24/developer-portfolio/blob/main/docs/SOURCE_REVIEW.md">
              {en ? 'Source review record' : '來源查核紀錄'}
            </a>
            {data.repository && (
              <p>
                <a href={data.repository}>
                  {en
                    ? 'Public repository and engineering documents'
                    : '公開儲存庫與工程文件'}
                </a>
              </p>
            )}
          </details>
        </section>
        <div class="article-footer">
          <a href={localizedPath(locale, 'projects')}>{copy.back}</a>
        </div>
      </article>
    </div>
  </div>
</Base>
