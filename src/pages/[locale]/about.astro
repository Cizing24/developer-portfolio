---
import Base from '../../layouts/Base.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { locales, localizedPath, t, type Locale } from '../../lib/i18n';
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const en = locale === 'en';
const copy = t(locale);
const principles = en
  ? [
      [
        'UNDERSTAND',
        'Start with the situation',
        'Map how people use the system, normal paths, failures and invariants. Equipment returns and offboarding are distinct steps within a shared business lifecycle.',
      ],
      [
        'MODEL',
        'Give rules explicit boundaries',
        'Interfaces provide feedback. APIs validate and authorize. Databases protect integrity. Typed contracts, state transitions and transactions connect those responsibilities.',
      ],
      [
        'VERIFY',
        'Show evidence of completion',
        'An operable screen is not proof of correctness. Unit, real-database integration and compiled-server browser tests address concurrency, authorization and rollback.',
      ],
      [
        'EVOLVE',
        'Keep the tradeoffs understandable',
        'Choose the simplest architecture that solves the problem. Record limitations and alternatives; use measurements and requirements to justify additional complexity.',
      ],
    ]
  : [
      [
        'UNDERSTAND',
        '先理解使用情境',
        '從人會如何操作系統開始，整理正常流程、失敗情境與真正不可違反的規則。設備歸還與離職交接，是同一條業務鏈上的不同步驟。',
      ],
      [
        'MODEL',
        '讓規則有明確的邊界',
        '介面提供回饋，API 執行驗證與授權，資料庫保護完整性。以型別契約、狀態機與交易邊界串起這些責任。',
      ],
      [
        'VERIFY',
        '用證據說明完成',
        '不把畫面能操作等同系統正確。透過單元、真實資料庫整合與正式編譯後的瀏覽器測試，驗證並行、權限與回滾。',
      ],
      [
        'EVOLVE',
        '保留可理解的取捨',
        '先選擇能解決問題的簡潔架構，記錄限制與替代方案。需要更多複雜度時，讓量測與需求成為理由。',
      ],
    ];
---

<Base
  title={copy.about}
  description={
    en
      ? 'CIZING’s full-stack direction: understand the problem, define contracts and verify the result.'
      : '認識 CIZING 的全端開發方向、問題拆解方式與以可驗證成果為基礎的工程理念。'
  }
>
  <div class="wrap">
    <section class="page-heading">
      <p class="eyebrow">ABOUT / THE ENGINEERING MINDSET</p>
      <h1>{en ? 'A thoughtful approach.' : '好的工程，始於清楚的問題。'}</h1>
      <p>
        {en
          ? 'I am CIZING. These complete software projects make requirements analysis, interface design, data modeling and verification visible.'
          : '我是 CIZING，專注全端開發，以完整的軟體專案呈現需求分析、介面設計、資料建模與交付驗證。'}
      </p>
    </section>
    <div class="about-grid">
      <aside>
        <p class="eyebrow">INTERFACES / SYSTEMS / DATA</p>
        <p class="large-copy">
          {en
            ? 'Consider the failure.\nDesign for the boundary.'
            : '多想一步失敗情境，\n讓可靠有跡可循。'}
        </p>
        <p class="muted">
          Vue 3 · Next.js · TypeScript
          <br />
          Fastify · PostgreSQL · Prisma
          <br />
          Vitest · Playwright · GitHub Actions
        </p>
      </aside>
      <div>
        {principles.map(([key, title, text], i) => (
          <section class="principle">
            <p class="eyebrow">
              0{i + 1} / {key}
            </p>
            <h2>{title}</h2>
            <p>{text}</p>
          </section>
        ))}
      </div>
    </div>
    <section class="page-content">
      <h2>{en ? 'The method, in practice.' : '把方法放進作品裡。'}</h2>
      <p class="large-copy">
        {en
          ? 'AssetFlow explores asset lifecycles and atomic audit. BookFlow explores tenant boundaries, scheduling and booking consistency.'
          : 'AssetFlow 聚焦資產生命週期與交易稽核；BookFlow 聚焦多租戶排程與預約一致性。'}
      </p>
      <p class="muted">
        {en
          ? 'This portfolio presents projects and design decisions. No unprovided employment history, education or job titles have been added.'
          : '這裡以專案與設計決策呈現能力，未填寫未提供的工作經歷、學歷或任職資訊。'}
      </p>
      <a class="text-link" href={localizedPath(locale, 'projects')}>
        {copy.projects}
      </a>
    </section>
  </div>
  <ContactCTA />
</Base>
