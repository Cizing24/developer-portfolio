---
import { getCollection } from 'astro:content';
import {
  locales,
  t,
  localizedPath,
  entrySlug,
  type Locale,
} from '../../../lib/i18n';
import Base from '../../../layouts/Base.astro';
import {
  publishedNotes,
  formatDate,
  readingMinutes,
} from '../../../lib/content';
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const en = locale === 'en';
const copy = t(locale);
const notes = publishedNotes(
  await getCollection('notes', (n) => n.data.locale === locale),
);
const categories = [...new Set(notes.map((n) => n.data.category))];
const tags = [...new Set(notes.flatMap((n) => n.data.tags))].sort();
---

<Base
  title={copy.notes}
  description={
    en
      ? 'Source-based notes on data consistency, data modeling and engineering decisions.'
      : '以實際專案為依據，記錄資料一致性、資料模型與工程決策的技術筆記。'
  }
>
  <div class="wrap page-content">
    <section class="page-heading">
      <p class="eyebrow">ENGINEERING NOTES / FIELD JOURNAL</p>
      <h1>
        {en ? 'Take the problem apart.' : '把問題拆開，'}
        <br />
        <span class="accent">
          {en ? 'Make the reasoning clear.' : '讓理解更清楚。'}
        </span>
      </h1>
      <p>
        {en
          ? 'Technical analysis grounded in real projects: the choices, verification methods and unresolved boundaries.'
          : '來自實際專案的技術分析。記錄選擇的理由、驗證的方法，以及還沒解決的邊界。'}
      </p>
    </section>
    <div class="filter-bar">
      <div class="filter-control">
        <label for="note-category">{copy.category}</label>
        <select id="note-category">
          <option value="">{copy.allCategories}</option>
          {categories.map((category) => (
            <option>{category}</option>
          ))}
        </select>
      </div>
      <div class="filter-control">
        <label for="note-tag">{copy.tag}</label>
        <select id="note-tag">
          <option value="">{copy.allTags}</option>
          {tags.map((tag) => (
            <option>{tag}</option>
          ))}
        </select>
      </div>
    </div>
    <p class="mono muted" id="note-count" aria-live="polite">
      {notes.length} NOTES
    </p>
    <div class="notes-list">
      {notes.map((note) => (
        <a
          class="note-row"
          data-category={note.data.category}
          data-tags={JSON.stringify(note.data.tags)}
          href={localizedPath(locale, `notes/${entrySlug(note.id)}`)}
        >
          <span class="mono muted">
            <time datetime={note.data.publishedAt}>
              {formatDate(note.data.publishedAt, en ? 'en' : 'zh-TW')}
            </time>
            <br />
            {readingMinutes(note.body)} MIN READ
          </span>
          <div>
            <span class="eyebrow">
              {note.data.category} / {note.data.tags.join(' · ')}
            </span>
            <h2 class="note-title">{note.data.title}</h2>
            <p>{note.data.description}</p>
          </div>
        </a>
      ))}
    </div>
    <p id="note-empty" hidden>
      {copy.empty}
    </p>
  </div>
</Base>
<style>
  .note-title {
    font-size: 1.25rem;
  }
  .note-row:hover .note-title {
    color: var(--accent);
  }
</style>
<script>
  const category = document.querySelector<HTMLSelectElement>('#note-category');
  const tag = document.querySelector<HTMLSelectElement>('#note-tag');
  function filterNotes() {
    let count = 0;
    document.querySelectorAll<HTMLElement>('.note-row').forEach((row) => {
      const tags = JSON.parse(row.dataset.tags ?? '[]') as string[];
      const visible =
        (!category?.value || row.dataset.category === category.value) &&
        (!tag?.value || tags.includes(tag.value));
      row.hidden = !visible;
      if (visible) count++;
    });
    const counter = document.querySelector('#note-count');
    if (counter) counter.textContent = `${count} NOTES`;
    const empty = document.querySelector<HTMLElement>('#note-empty');
    if (empty) empty.hidden = count > 0;
  }
  category?.addEventListener('change', filterNotes);
  tag?.addEventListener('change', filterNotes);
</script>
