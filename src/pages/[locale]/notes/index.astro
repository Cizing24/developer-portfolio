---
import { getCollection } from 'astro:content';
import { locales, type Locale } from '../../../lib/i18n';
import Base from '../../../layouts/Base.astro';
import { publishedNotes } from '../../../lib/content';
import EngineeringLab from '../../../components/EngineeringLab.astro';
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const en = locale === 'en';
const notes = publishedNotes(
  await getCollection('notes', (n) => n.data.locale === locale),
);
---

<Base
  title={en ? 'Engineering Lab' : 'Engineering Lab 工程實驗室'}
  description={
    en
      ? 'Source-based notes on data consistency, data modeling and engineering decisions.'
      : '以實際專案為依據，記錄資料一致性、資料模型與工程決策的技術筆記。'
  }
>
  <div class="wrap page-content">
    <section class="page-heading">
      <p class="eyebrow">CIZING / ENGINEERING LAB</p>
      <h1>{en ? 'Engineering Lab' : '工程實驗室'}</h1>
    </section>
    <EngineeringLab locale={locale} notes={notes} />
  </div>
</Base>
