---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import FlowSimulation from '../../components/FlowSimulation.astro';
import {
  locales,
  localizedPath,
  t,
  type Locale,
  entrySlug,
} from '../../lib/i18n';
import { sortProjects, publishedNotes, formatDate } from '../../lib/content';
export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
const en = locale === 'en';
const copy = t(locale);
const projects = sortProjects(
  await getCollection('projects', (p) => p.data.locale === locale),
).filter((p) => p.data.featured);
const notes = publishedNotes(
  await getCollection('notes', (n) => n.data.locale === locale),
);
const anchorMap = Object.fromEntries(
  ['main', 'work', 'lab', 'method', 'journal'].map((id) => [id, id]),
);
---

<Base
  title={
    en ? 'Complex rules. Reliable software.' : '把複雜規則，寫成可靠的軟體。'
  }
  anchorMap={anchorMap}
>
  <section class="wrap hero">
    <div class="hero-meta mono">
      <span>AN INDEPENDENT ENGINEERING JOURNAL</span>
      <span>PORTFOLIO / VOL. 02 · 2026</span>
    </div>
    <div class="hero-layout">
      <div class="hero-copy">
        <p class="eyebrow">CIZING24 / SOFTWARE ENGINEER</p>
        <h1>
          {en ? (
            <>
              Complex rules.
              <br />
              <em>Reliable software.</em>
            </>
          ) : (
            <>
              把複雜規則，
              <br />
              寫成<span class="accent">可靠的軟體。</span>
            </>
          )}
        </h1>
        <p class="intro">
          {en
            ? 'From user journeys and APIs to the database. Engineering decisions made visible through AssetFlow and BookFlow.'
            : '從使用者流程、API 到資料庫。以 AssetFlow 與 BookFlow，呈現可解釋、可驗證的工程判斷。'}
        </p>
        <a class="button" href="#work">
          {en ? 'Read selected work' : '翻開精選案例'}
        </a>
      </div>
      <aside class="editor-note">
        <span class="note-number" aria-hidden="true">
          24
        </span>
        <p class="mono">OBSERVE / BUILD / VERIFY</p>
        <p>
          {en
            ? 'A little more thought at the boundary. A lot more trust in the system.'
            : '不只是多寫一點程式，\n而是多想一步邊界。'}
        </p>
        <a class="text-link" href="#lab">
          {en ? 'Inside the engineering lab' : '走進工程實驗室'}
        </a>
      </aside>
    </div>
    <div class="hero-foot mono">
      <span>
        {en
          ? 'TWO SYSTEMS. TWO CONSISTENCY PROBLEMS.'
          : '兩個系統，兩種一致性問題。'}
      </span>
      <span>TYPESCRIPT / INTERFACES / DATA</span>
    </div>
  </section>
  <section id="work" class="wrap section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / SELECTED WORK</p>
        <h2>{copy.workTitle}</h2>
      </div>
      <a class="text-link" href={localizedPath(locale, 'projects')}>
        {copy.allProjects}
      </a>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </section>
  <section id="lab" class="lab-section">
    <div class="wrap section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / ENGINEERING IN ACTION</p>
          <h2>{en ? 'Rules, made visible.' : '規則，看得見。'}</h2>
        </div>
        <p class="section-note">
          {en
            ? 'Explore the boundary between intent and commit.'
            : '從一次操作，看懂意圖與提交之間的邊界。'}
        </p>
      </div>
      <FlowSimulation system="bookflow" />
      <p class="lab-foot">
        <a
          class="text-link"
          href={localizedPath(locale, 'projects/assetflow') + '#simulation'}
        >
          {en
            ? 'Explore the AssetFlow lifecycle simulation'
            : '體驗 AssetFlow 資產生命週期模擬'}
        </a>
      </p>
    </div>
  </section>
  <section id="method" class="wrap section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">03 / ENGINEERING APPROACH</p>
        <h2>
          {en
            ? 'Define the boundary.\nThen build the system.'
            : '先定義邊界，\n再讓系統運作。'}
        </h2>
      </div>
      <a class="text-link" href={localizedPath(locale, 'about')}>
        {copy.about}
      </a>
    </div>
    <div class="method-steps">
      {(en
        ? [
            [
              'Understand the context',
              'An asset cannot be assigned twice. A staff member cannot occupy overlapping slots.',
            ],
            [
              'Establish contracts',
              'Keep authorization, state transitions and date semantics at explicit boundaries.',
            ],
            [
              'Verify the tradeoffs',
              'Test failure cases. Preserve limitations and traceable sources.',
            ],
          ]
        : [
            ['理解情境', '設備不能重複領用；同一時段不能重複占用。'],
            ['建立契約', '把授權、狀態與日期語意放在正確邊界。'],
            ['驗證取捨', '檢查失敗情境，保留限制與可追溯來源。'],
          ]
      ).map(([title, description], index) => (
        <article>
          <span class="method-number">0{index + 1}</span>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>
  <section id="journal" class="wrap section journal">
    <div class="section-heading">
      <div>
        <p class="eyebrow">04 / FIELD NOTES</p>
        <h2>{en ? 'The reasoning stays.' : '留下決策的脈絡。'}</h2>
      </div>
      <a class="text-link" href={localizedPath(locale, 'notes')}>
        {copy.allNotes}
      </a>
    </div>
    {notes.map((note) => (
      <a
        class="note-row"
        href={localizedPath(locale, `notes/${entrySlug(note.id)}`)}
      >
        <span class="mono muted">
          {formatDate(note.data.publishedAt, locale === 'en' ? 'en' : 'zh-TW')}
        </span>
        <div>
          <span class="eyebrow">{note.data.category}</span>
          <h3>{note.data.title}</h3>
          <p>{note.data.description}</p>
        </div>
      </a>
    ))}
  </section>
  <ContactCTA />
</Base>
